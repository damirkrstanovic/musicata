#!/usr/bin/env bash
# Pre-commit gate: the Rust tests plus the headless UI/lag smoke suite must pass
# before a commit lands. Enable once per clone with:
#
#     git config core.hooksPath .githooks
#
# Skip ad hoc with `SKIP_HOOKS=1 git commit …` or `git commit --no-verify`.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ "${SKIP_HOOKS:-0}" = "1" ]; then
  echo "pre-commit: skipped (SKIP_HOOKS=1)"
  exit 0
fi

echo "pre-commit: cargo test"
cargo test --quiet

echo "pre-commit: cargo test (provider-smb)"
cargo test --quiet --features provider-smb -p musicata-server

echo "pre-commit: UI / lag smoke suite"
# Builds the server, then drives the real app in headless Chromium. Skips cleanly
# (exit 0) if no Chromium is installed, so it never blocks commits on bare machines.
scripts/ui-smoke.sh

echo "pre-commit: all checks passed"
